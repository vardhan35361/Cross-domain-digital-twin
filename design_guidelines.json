{
  "project_name": "Hyderabad Traffic Digital Twin",
  "app_type": "hybrid_fullstack",
  "archetype": "ELECTRIC & NEON / LUXURY Command Center",
  "typography": {
    "heading_font": "Outfit, sans-serif",
    "body_font": "Plus Jakarta Sans, sans-serif",
    "mono_font": "JetBrains Mono, monospace"
  },
  "colors": {
    "background": "#050B14",
    "surface": "#0B132B",
    "surface_glass": "rgba(11, 19, 43, 0.75)",
    "border": "rgba(0, 243, 255, 0.2)",
    "primary": "#00F3FF",
    "secondary": "#7000FF",
    "accent": "#00FF66",
    "warning": "#FFB703",
    "danger": "#FF0055",
    "text_main": "#F8FAFC",
    "text_muted": "#94A3B8"
  },
  "visual_enhancers": {
    "glassmorphism": "backdrop-blur-xl bg-[#0B132B]/80 border border-[#00F3FF]/20 shadow-[0_8px_32px_rgba(0,243,255,0.1)]",
    "glow_effect": "drop-shadow-[0_0_12px_rgba(0,243,255,0.4)]",
    "scanlines": true
  },
  "grids": {
    "bento_dashboard": "grid grid-cols-1 md:grid-cols-12 gap-6 p-6"
  },
  "motion": {
    "transition": "transition-all duration-300 ease-in-out",
    "hover_lift": "hover:-translate-y-1 hover:shadow-[0_10px_25px_rgba(0,243,255,0.2)]"
  },
  "accessibility": {
    "contrast_ratio": "APCA compliant > 4.5:1 for all interactive text",
    "reduced_motion_support": true,
    "interactive_test_ids": "MANDATORY: all buttons, inputs, widgets must have data-testid"
  },
  "image_urls": [],
  "3d_libraries": [
    "Three.js",
    "React Three Fiber",
    "Drei",
    "Deck.gl"
  ]
}